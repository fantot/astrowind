---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Features from '~/components/widgets/Features.astro';
import FAQs from '~/components/widgets/FAQs.astro';

const metadata = {
  title: '让 AI 更简单、更好用',
  description: 'AI 工具使用、订阅咨询与实用知识分享。',
  ignoreTitleTemplate: true,
};

const services = [
  {
    id: 'chatgpt',
    name: 'ChatGPT',
    icon: 'tabler:brand-openai',
    desc: '从日常问答到专业工作流，帮你真正用好 ChatGPT。',
    tags: ['订阅咨询', '账号使用', '提示词与效率'],
  },
  {
    id: 'claude',
    name: 'Claude',
    icon: 'tabler:sparkles',
    desc: '适合长文档、写作与编程场景的使用建议和问题排查。',
    tags: ['订阅咨询', '长文处理', 'Claude Code'],
  },
  {
    id: 'grok',
    name: 'Grok',
    icon: 'tabler:brand-x',
    desc: 'xAI 推出的智能助手，适合实时信息获取、热点分析与创意对话。',
    tags: ['会员充值', '实时信息', '使用指导'],
  },
  {
    id: 'gemini',
    name: 'Gemini',
    icon: 'tabler:brand-google',
    desc: '结合 Google 生态，提供会员充值、模型选择与实际应用指导。',
    tags: ['会员充值', '模型对比', 'Google 生态'],
  },
];
---

<Layout metadata={metadata}>
  <Hero
    id="home"
    tagline="AI会员充值 · 实用知识 · 一对一咨询"
    title={'让 AI 更简单、<span class="text-primary">更好用</span>'}
    subtitle="AI 工具使用、订阅咨询与实用知识分享。少走弯路，把合适的 AI 真正用进工作和生活。"
    actions={[
      { variant: 'primary', text: '查看会员充值', href: '#services', icon: 'tabler:arrow-down' },
      { text: '咨询客服', href: '#consult-author', icon: 'tabler:message-circle' },
    ]}
  >
    <Fragment slot="bg">
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_50%_15%,rgba(37,99,235,0.14),transparent_38%)] dark:bg-[radial-gradient(circle_at_50%_15%,rgba(59,130,246,0.18),transparent_42%)]"
      >
      </div>
    </Fragment>
    <Fragment slot="content">
      <div class="mx-auto mt-10 grid max-w-4xl grid-cols-4 gap-3 text-sm text-muted sm:gap-6">
        <div><strong class="block text-2xl text-default dark:text-white">正规</strong>充值渠道</div>
        <div><strong class="block text-2xl text-default dark:text-white">可靠</strong>可走第三方电商</div>
        <div><strong class="block text-2xl text-default dark:text-white">持续</strong>内容更新</div>
        <div><strong class="block text-2xl text-default dark:text-white">一对一</strong>问题咨询</div>
      </div>
    </Fragment>
  </Hero>

  <section id="services" class="scroll-mt-24 py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <p class="mb-2 font-semibold text-primary">AI会员充值</p>
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">主流 AI 会员，按需选择</h2>
        <p class="mt-4 text-muted">提供主流 AI 工具会员充值咨询，并根据你的实际需求给出版本和使用建议。</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          services.map((service) => (
            <article class="group flex min-h-80 flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-blue-300 hover:shadow-xl dark:border-slate-700 dark:bg-slate-900/60">
              <Icon name={service.icon} class="h-11 w-11 rounded-2xl bg-blue-50 p-2.5 text-primary dark:bg-blue-950" />
              <h3 class="mt-5 text-xl font-bold">{service.name}</h3>
              <p class="mt-3 flex-1 text-sm leading-6 text-muted">{service.desc}</p>
              <ul class="my-5 flex flex-wrap gap-2" aria-label="服务内容">
                {service.tags.map((tag) => (
                  <li class="rounded-full bg-slate-100 px-2.5 py-1 text-xs text-muted dark:bg-slate-800">{tag}</li>
                ))}
              </ul>
              <div class="flex items-center justify-between text-sm font-semibold">
                <a href={`/services#${service.id}`} class="text-primary hover:underline">
                  查看详情
                </a>
                <a href="#consult-author" class="text-default hover:text-primary dark:text-white">
                  立即咨询 →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <BlogLatestPosts
    id="knowledge"
    title="最新 AI 知识"
    linkText="查看全部文章"
    information="持续分享 AI 工具教程、实战技巧、会员选择和避坑经验，让每一次学习都有实际收获。"
    count={4}
  />

  <Features
    id="why-us"
    tagline="为什么选择我们"
    title="从真实问题出发，给出能落地的建议"
    columns={3}
    items={[
      {
        title: '最优价格',
        description: '官方渠道优先，始终把稳定放在第一位。兼顾更低价格，提供适合长期使用的选择。',
        icon: 'tabler:flask',
      },
      {
        title: '内容持续更新',
        description: '跟进模型与产品变化，及时修正过时教程和使用建议。',
        icon: 'tabler:refresh',
      },
      { title: '一对一咨询', description: '结合你的目标、预算和使用环境，减少试错成本。', icon: 'tabler:messages' },
    ]}
  />

  <FAQs
    id="faq"
    tagline="常见问题"
    title="开始前，你可能想了解"
    columns={2}
    items={[
      {
        title: '可以直接在网站购买订阅吗？',
        description: '暂时不提供在线支付。请先联系客服说明需求，确认适合的方案与注意事项。',
      },
      {
        title: '咨询哪些 AI 工具？',
        description: '目前提供 ChatGPT、Claude、Grok 和 Gemini 的会员充值与使用咨询。',
      },
      {
        title: '能保证账号或服务永久可用吗？',
        description: '不能。AI 产品政策和可用性会变化，我们会如实说明风险，并提供当前可行的建议。',
      },
      {
        title: '知识库内容会持续更新吗？',
        description: '会。文章使用 Markdown / MDX 发布，将持续补充教程、工具对比、实战技巧和避坑内容。',
      },
    ]}
  />

  <section id="contact" class="px-4 py-16 sm:px-6 md:py-24">
    <div
      class="relative mx-auto max-w-6xl overflow-hidden rounded-[2rem] bg-slate-950 px-6 py-12 text-center text-white shadow-2xl sm:px-12 md:py-16"
    >
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(59,130,246,0.35),transparent_45%)]">
      </div>
      <div class="relative mx-auto max-w-2xl">
        <p class="font-semibold text-blue-300">联系客服</p>
        <h2 class="mt-3 text-3xl font-bold sm:text-4xl">有具体问题？直接聊聊</h2>
        <p class="mt-4 leading-7 text-slate-300">
          告诉我你正在使用的工具、遇到的问题或希望实现的目标，我会尽量给出清晰、务实的建议。
        </p>
        <a href="#consult-author" class="btn-primary mt-7 inline-flex items-center gap-2"
          >查看企业微信二维码 <Icon name="tabler:qrcode" class="h-5 w-5" /></a
        >
      </div>
    </div>
  </section>
</Layout>
