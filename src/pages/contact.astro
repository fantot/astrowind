---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
const metadata = { title: '联系作者', description: '通过企业微信联系作者，咨询 AI 工具订阅与使用问题。' };
---

<Layout metadata={metadata}>
  <Hero
    tagline="联系作者"
    title={'让我们聊聊你的 <span class="text-primary">AI 需求</span>'}
    subtitle="请先简单说明想咨询的工具、遇到的问题和期望目标，沟通会更高效。"
    actions={[{ variant: 'primary', text: '查看企业微信二维码', href: '#consult-author', icon: 'tabler:qrcode' }]}
  />
  <Features
    title="适合咨询这些问题"
    columns={3}
    items={[
      {
        title: '订阅前怎么选',
        description: '结合预算、设备和使用场景，判断是否值得订阅以及选择哪个版本。',
        icon: 'tabler:route',
      },
      {
        title: '使用中遇到问题',
        description: '梳理常见账号、功能、模型选择与使用方式问题。',
        icon: 'tabler:help-circle',
      },
      {
        title: '工作流怎么搭',
        description: '围绕写作、研究、编程、绘图或视频等目标给出思路。',
        icon: 'tabler:assembly',
      },
    ]}
  />
</Layout>
