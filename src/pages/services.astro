---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';

const metadata = { title: 'AI 服务', description: 'ChatGPT、Claude、Gemini 与其他 AI 工具的订阅咨询和使用指导。' };
const services = [
  {
    id: 'chatgpt',
    name: 'ChatGPT',
    icon: 'tabler:brand-openai',
    intro: '适合通用问答、写作、数据分析、图像与深度研究等场景。',
    items: ['版本与订阅方案选择', '账号和常见使用问题', '提示词、GPTs 与工作流建议'],
  },
  {
    id: 'claude',
    name: 'Claude',
    icon: 'tabler:sparkles',
    intro: '擅长长文本、严谨写作、代码理解与复杂资料处理。',
    items: ['订阅与模型选择建议', '长文档和写作场景指导', 'Claude Code 基础使用'],
  },
  {
    id: 'gemini',
    name: 'Gemini',
    icon: 'tabler:brand-google',
    intro: '与 Google 产品生态结合紧密，适合研究、办公和多模态任务。',
    items: ['版本差异与适用场景', 'Google 生态协作建议', '常见问题与使用指导'],
  },
  {
    id: 'other',
    name: '其他 AI 工具',
    icon: 'tabler:apps',
    intro: '根据实际需求选择 AI 绘图、AI 视频和效率类产品。',
    items: ['工具选型与横向比较', 'AI 绘图、视频入门', '付费前风险与避坑建议'],
  },
];
---

<Layout metadata={metadata}>
  <Hero
    tagline="AI 服务"
    title={'帮你选对工具，<span class="text-primary">少走弯路</span>'}
    subtitle="从需求判断、订阅选择到实际使用，提供清晰、务实的一对一建议。暂不提供在线支付，请先联系作者确认需求。"
    actions={[
      { variant: 'primary', text: '咨询作者', href: '#consult-author', icon: 'tabler:message-circle' },
      { text: '阅读 AI 知识', href: '/blog' },
    ]}
  />
  <section class="pb-20 md:pb-28">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 sm:px-6 md:grid-cols-2">
      {
        services.map((service) => (
          <article
            id={service.id}
            class="scroll-mt-28 rounded-3xl border border-slate-200 bg-white p-7 shadow-sm dark:border-slate-700 dark:bg-slate-900/60 sm:p-8"
          >
            <div class="flex items-center gap-4">
              <>
                <Icon name={service.icon} class="h-12 w-12 rounded-2xl bg-blue-50 p-3 text-primary dark:bg-blue-950" />
                <h2 class="text-2xl font-bold">{service.name}</h2>
              </>
            </div>
            <p class="mt-5 leading-7 text-muted">{service.intro}</p>
            <h3 class="mt-6 font-semibold">可咨询内容</h3>
            <ul class="mt-3 space-y-2 text-sm text-muted">
              {service.items.map((item) => (
                <li class="flex gap-2">
                  <Icon name="tabler:check" class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
                  {item}
                </li>
              ))}
            </ul>
            <a href="#consult-author" class="btn-primary mt-7 inline-flex">
              立即咨询
            </a>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
