---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';

const metadata = {
  title: 'AI会员充值',
  description: 'ChatGPT、Claude、Grok 与 Gemini 的会员充值咨询和使用指导。',
};
const services = [
  {
    id: 'chatgpt',
    name: 'ChatGPT',
    icon: 'tabler:brand-openai',
    intro: '适合通用问答、写作、数据分析、图像与深度研究等场景。',
    items: [
      '版本与订阅方案选择',
      '账号和常见使用问题',
      '提示词、GPTs 与工作流建议',
      'Plus 最低 129 元/月，30 天质保，可开票',
    ],
  },
  {
    id: 'claude',
    name: 'Claude',
    icon: 'tabler:sparkles',
    intro: '擅长长文本、严谨写作、代码理解与复杂资料处理。',
    items: [
      '订阅与模型选择建议',
      '长文档和写作场景指导',
      'Claude Code 基础使用',
      'Pro 最低 138 元/月，30 天质保，可开票',
    ],
  },
  {
    id: 'grok',
    name: 'Grok',
    icon: 'tabler:brand-x',
    intro: '由 xAI 推出，适合实时信息获取、热点分析和多模态任务。',
    items: [
      '会员版本与充值咨询',
      '实时信息与热点分析',
      '常见功能和使用指导',
      'SuperGrok 套餐，价格咨询，30 天质保，可开票',
    ],
  },
  {
    id: 'gemini',
    name: 'Gemini',
    icon: 'tabler:brand-google',
    intro: '与 Google 产品生态结合紧密，适合研究、办公和多模态任务。',
    items: [
      '会员版本与充值咨询',
      'Google 生态协作建议',
      '常见问题与使用指导',
      'Google AI Pro 套餐，价格咨询，30 天质保，可开票',
    ],
  },
];
---

<Layout metadata={metadata}>
  <Hero
    title={'主流 AI 会员充值，<span class="text-primary">简单省心</span>'}
    subtitle="提供 ChatGPT、Claude、Grok 和 Gemini 会员充值咨询，并结合实际需求给出版本选择与使用建议。暂不提供在线支付，请先联系客服确认。"
    actions={[
      { variant: 'primary', text: '咨询客服', href: '#consult-author', icon: 'tabler:message-circle' },
      { text: '阅读 AI 知识', href: '/blog' },
    ]}
  />
  <section class="pb-20 md:pb-28">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 sm:px-6 md:grid-cols-2">
      {
        services.map((service) => (
          <article
            id={service.id}
            class="scroll-mt-28 rounded-3xl border border-slate-200 bg-white p-7 shadow-sm dark:border-slate-700 dark:bg-slate-900/60 sm:p-8"
          >
            <div class="flex items-center gap-4">
              <>
                <Icon name={service.icon} class="h-12 w-12 rounded-2xl bg-blue-50 p-3 text-primary dark:bg-blue-950" />
                <h2 class="text-2xl font-bold">{service.name}</h2>
              </>
            </div>
            <p class="mt-5 leading-7 text-muted">{service.intro}</p>
            <h3 class="mt-6 font-semibold">可咨询内容</h3>
            <ul class="mt-3 space-y-2 text-sm text-muted">
              {service.items.map((item) => (
                <li class="flex gap-2">
                  <Icon name="tabler:check" class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
                  {item}
                </li>
              ))}
            </ul>
            <a href="#consult-author" class="btn-primary mt-7 inline-flex">
              立即咨询
            </a>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
